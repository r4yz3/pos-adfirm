{
  "name": "adfirm-micro-pos",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "node --watch server/index.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.mjs",
    "test": "node --test server/tests/*.test.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "android:sync": "npm run build && cap sync android",
    "android:build": "node scripts/android-build.mjs",
    "android:open": "cap open android",
    "backup": "node scripts/backup.mjs",
    "backup:verify": "node scripts/verify-backup.mjs",
    "backup:restore": "node scripts/restore-backup.mjs",
    "check:records": "node scripts/check-records.mjs",
    "images:cleanup": "node scripts/cleanup-images.mjs",
    "test:pilot": "node scripts/pilot-smoke.mjs",
    "test:postgres": "node scripts/postgres-test.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1152.0",
    "@aws-sdk/s3-request-presigner": "3.1152.0",
    "@capacitor/android": "8.5.3",
    "@capacitor/barcode-scanner": "3.1.3",
    "@capacitor/camera": "8.2.5",
    "@capacitor/core": "8.5.3",
    "@fastify/cors": "11.3.1",
    "@fastify/multipart": "10.1.4",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "10.1.6",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "dexie": "4.4.6",
    "fastify": "5.12.7",
    "lucide-react": "^0.468.0",
    "pg": "^8.16.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "^5.9.3",
    "vite": "8.3.4"
  }
}
