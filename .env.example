# Development only. Disable DEMO_MODE and set bootstrap credentials for deployment.
DEMO_MODE=true
HOST=127.0.0.1
PORT=4100
# Native CloudPanel only: trust forwarded client IPs from the local NGINX proxy.
# TRUST_PROXY=loopback
SQLITE_PATH=./data/adfirm.sqlite
# Set DATABASE_URL to use PostgreSQL instead of local SQLite.
# DATABASE_URL=postgresql://adfirm:password@localhost:5432/adfirm
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-unique-password
# CORS_ORIGINS=https://your-admin.example.com,https://localhost
# Owners can create their own account from the sign-in screen. Set to false to close sign-up.
# PUBLIC_SIGNUP=true
# Android: HTTPS API base URL, including /api. Rebuild after changing.
# VITE_API_URL=https://api.example.com/api
# Cloudflare R2: server-side credentials only. Use a bucket-scoped R2 token.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=adfirm-product-images
# IMAGE_SIGNING_SECRET=replace-with-a-long-random-value

# Optional online photo recognition. Separate usage charges apply to your vision API account.
# Explicit opt-in; keys stay server-side. Never put this key in VITE_* variables.
VISION_ENABLED=false
# VISION_OPENAI_API_KEY=
VISION_MODEL=gpt-4.1-mini
VISION_DAILY_LIMIT=30
